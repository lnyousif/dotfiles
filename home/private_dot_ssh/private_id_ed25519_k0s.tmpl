{{- /* Prefer the key from KeePassXC so rotations reach every machine; */ -}}
{{- /* fall back to the existing file when KeePassXC isn't unlocked.  */ -}}
{{- $key := includeTemplate "k0s/hub_key" . -}}
{{- $targetFile := joinPath .chezmoi.homeDir ".ssh" "id_ed25519_k0s" -}}
{{- if $key -}}
{{-   $key -}}
{{- else if stat $targetFile -}}
{{-   include $targetFile -}}
{{- end -}}
