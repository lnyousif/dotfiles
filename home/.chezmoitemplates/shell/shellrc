# Interactive shell setup shared by bash and zsh (environment lives in ~/.config/shell/env.sh)


# Load shared functions, extras and aliases (bash and zsh compatible)
for rc_file in _functions _extra _aliases; do
    if [ -f "$HOME/.myscripts/$rc_file" ]; then
        # shellcheck source=/dev/null
        \. "$HOME/.myscripts/$rc_file"
    fi
done
unset rc_file

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# 1. Use fd for fzf (includes hidden/gitignored files)
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# 2. Use bat for fzf preview window
export FZF_DEFAULT_OPTS="--ansi --preview 'bat --color=always --style=numbers --line-range :500 {}'"
