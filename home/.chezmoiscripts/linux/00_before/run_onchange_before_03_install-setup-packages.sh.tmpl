#!/usr/bin/env bash

export PATH="$HOME/.local/bin:$PATH"

# Homebrew isn't on PATH yet on a fresh machine (shell rc files aren't sourced here)
if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi
{{ range $setup, $value := .setups }}

  {{ if $value }}
    echo "Install Packages for: {{ $setup }}"
    # Linux self installing packages
    echo "Installing self installing packages"

    {{ range index $.packages $setup "linux" "linux_cmd" }}
      {{ if . }}bash -c {{ . | replace "{arch}" $.chezmoi.arch | quote }}{{ end }}
    {{ end }}

    # Native packages
    {{/* Native packages need root; "normal" users skip straight to the user-level installs */}}
    {{ if not $.superuser }}
        echo "No sudo access: skipping native packages"

    {{ else if or (contains "debian" $.osid) (contains "ubuntu" $.osid) }}
        ## Debian
        echo "Installing Debian Packages"

        {{ range index $.packages $setup "linux" "apt" }}
        {{ $.superuser }} apt install -y {{. | quote }}
        {{ end }}

        {{ range index $.packages $setup "linux" "apt_junk" }}
        {{ $.superuser }} apt remove -y {{ . | quote }}
        {{ end }}

    {{ else if contains "fedora" $.osid }}
        ## Fedora
        echo "Installing RPM packages"


        {{ range index $.packages $setup "linux" "apt" }}
        {{ $.superuser }} dnf install -y {{ . | quote }}
        {{ end }}

        {{ range index $.packages $setup "linux" "apt_junk" }}
        {{ $.superuser }} dnf remove -y {{ . | quote }}
        {{ end }}


    {{ else if contains "alpine" $.osid }}
        ## Alpine
        echo "Installing APK packages"

        {{ range index $.packages $setup "linux" "apt" }}
        {{ $.superuser }} apk add --no-cache {{ . | quote }}
        {{ end }}

        {{ range index $.packages $setup "linux" "apt_junk" }}
        {{ $.superuser }} apk del {{ . | quote }}
        {{ end }}


    {{ else if contains "arch" $.osid }}
        ## Arch
        echo "Installing Arch packages"

        {{ $.superuser }} pacman -Syu --needed --noconfirm {{ range index $.packages $setup "linux" "apt" }} {{.}}{{end}}

    {{ end }}


    echo "Installing brew packages"
    # Homebrew packages
    {{ range index $.packages $setup "linux" "brews" -}}
        brew install {{ . | quote }}
    {{ end -}}

    # Python packages
    echo "Installing Python packages with pipx or pip"

    {{ range index $.packages $setup "linux" "pips" }}
      if command -v pipx &>/dev/null; then
        pipx install {{ . | quote }}
      else
        python3 -m pip install --user {{ . | quote }}
      fi
    {{ end }}


  {{ end }}

{{ end }}

# Fallback: micro isn't packaged everywhere (e.g. RHEL without EPEL) or there was no sudo.
# The official installer drops a static binary into the current directory.
if ! command -v micro &> /dev/null; then
  echo "micro not found; installing it to ~/.local/bin"
  mkdir -p "$HOME/.local/bin"
  (cd "$HOME/.local/bin" && curl -fsSL https://getmic.ro | bash) || echo "micro install failed"
fi
